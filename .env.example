# ── LinkedIn job-retrieval — environment example ──────────────────────────────
# Copy to `.env` and adjust. `.env` is gitignored.
#
# IMPORTANT: LinkedIn credentials are NOT stored here. The MCP server logs you in
# through a real browser window and persists the session in a local browser
# profile at ~/.linkedin-mcp/. Nothing in this repo holds your password.
# One-time login:  uvx mcp-server-linkedin@latest --login

# ── MCP server tuning (consumed by mcp-server-linkedin) ───────────────────────
# See github.com/stickerdaniel/linkedin-mcp-server .env.example for the full list.

# Seconds. uv's HTTP timeout for first-run dependency/Chromium download.
UV_HTTP_TIMEOUT=300

# Seconds. Per-tool execution timeout. Raise for multi-page searches / cold start.
TOOL_TIMEOUT=300

# Milliseconds. Browser page-operation timeout (element wait / navigation).
TIMEOUT=10000

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=WARNING

# ── Project settings (consumed by this project's runbook, not the server) ─────
# Where retrieved job descriptions are written. Relative to the automation folder.
OUTPUT_DIR=../data

# Politeness throttle between get_job_details calls, in seconds. Keep human-paced.
FETCH_DELAY_SECONDS=8

# Max job detail fetches per run. A guardrail against tripping automation limits.
MAX_FETCHES_PER_RUN=15

# ── Fantastic.jobs (consumed by pipeline/scripts/sources/fantastic_fetch.py) ───────────────────
# Bearer key from the Fantastic.jobs subscriptions page. Billed per job returned.
FANTASTIC_JOBS_API_KEY=
